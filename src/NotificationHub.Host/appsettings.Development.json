{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.EntityFrameworkCore": "Warning",
      "NotificationHub": "Debug"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=6432;Database=notificationhub;Username=notificationhub;Password=notificationhub;Minimum Pool Size=5;Maximum Pool Size=20;Pooling=true;Timeout=15;Command Timeout=30;No Reset On Close=true;Application Name=NotificationHub"
  },
  "RabbitMQ": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "notificationhub",
    "Password": "notificationhub",
    "VirtualHost": "/",
    "QueueName": "notifications",
    "ExchangeName": "notifications.exchange",
    "RoutingKey": "notification.send",
    "PrefetchCount": 10
  },
  "Providers": {
    "PreferredEmailProvider": "email-sendgrid",
    "PreferredSmsProvider": "sms-kavenegar",
    "EmailFallbackOrder": [
      "email-sendgrid",
      "email-smtp"
    ],
    "SmsFallbackOrder": [
      "sms-kavenegar",
      "sms-smsir"
    ]
  },
  "Auth": {
    "ApiKey": "dev-secret-key-change-me",
    "BootstrapApiKey": "dev-secret-key-change-me"
  },
  "RateLimiting": {
    "PerMinute": 120
  },
  "Plugins": {
    "SendGrid": {
      "ApiKey": "",
      "FromEmail": "",
      "FromName": "NotificationHub"
    },
    "Smtp": {
      "Host": "",
      "Port": 587,
      "Username": "",
      "Password": "",
      "EnableSsl": true,
      "FromEmail": "",
      "FromName": "NotificationHub"
    },
    "Kavenegar": {
      "ApiKey": "",
      "Sender": ""
    },
    "SmsIr": {
      "ApiKey": "",
      "LineNumber": ""
    },
    "Slack": {
      "WebhookUrl": ""
    },
    "WhatsApp": {
      "AccessToken": "",
      "PhoneNumberId": ""
    },
    "Fcm": {
      "ServerKey": ""
    }
  },
  "Costs": {
    "Providers": [
      {
        "ProviderId": "sms-kavenegar",
        "CostPerMessage": 200,
        "Currency": "IRR"
      },
      {
        "ProviderId": "sms-smsir",
        "CostPerMessage": 180,
        "Currency": "IRR"
      },
      {
        "ProviderId": "email-sendgrid",
        "CostPerMessage": 0.001,
        "Currency": "USD"
      },
      {
        "ProviderId": "email-smtp",
        "CostPerMessage": 0,
        "Currency": "USD"
      }
    ]
  },
  "ProviderHealth": {
    "MinSamples": 5,
    "UnhealthyThreshold": 0.5,
    "WindowSize": 50,
    "DeprioritizeUnhealthy": true
  }
}
