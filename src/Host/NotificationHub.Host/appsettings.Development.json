      "WebhookUrl": ""
    },
    "Twilio": {
      "AccountSid": "",
      "AuthToken": "",
      "From": ""
    },
    "Resend": {
      "ApiKey": "",
      "From": ""
    },
    "Ses": {
      "AccessKeyId": "",
      "SecretAccessKey": "",
      "Region": "us-east-1",
      "From": ""
    },
    "Expo": {
      "AccessToken": ""
    },
    "Directory": ""
