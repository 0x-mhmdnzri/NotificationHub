{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.EntityFrameworkCore": "Warning",
      "NotificationHub": "Debug"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1",
  "Auth": {
    "BootstrapApiKey": ""
  },
  "RateLimiting": {
    "PerMinute": 120,
    "AuthFailuresPerMinute": 60
