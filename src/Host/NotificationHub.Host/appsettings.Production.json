{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Error",
      "NotificationHub": "Information"
    }
  },
  "AllowedHosts": "api.example.com",
  "ConnectionStrings": {
    "Default": "",
    "Redis": ""
  },
  "RabbitMQ": {
    "HostName": "",
    "Port": 5672,
    "UserName": "",
    "Password": "",
    "PrefetchCount": 64,
    "WorkerMaxConcurrency": 32,
    "ConsumerBufferCapacity": 128
  },
  "Auth": {
    "BootstrapApiKey": "",
    "AdminIpAllowlist": []
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "RateLimiting": {
    "PerMinute": 300,
    "AuthFailuresPerMinute": 20,
    "TrackingPerMinute": 120
  },
  "ForwardedHeaders": {
    "KnownProxies": []
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Error",
        "System": "Warning"
      }
    }
  },
  "OpenTelemetry": {
    "OtlpEndpoint": ""
  },
  "Campaigns": {
    "BatchSize": 200,
    "PollIntervalMs": 2000
  },
  "HighLoad": {
    "MaxRequestBodyBytes": 2097152,
    "KeepAliveSeconds": 120,
    "RequestHeadersTimeoutSeconds": 30,
    "SustainedLowLatencyGc": true
  }
}
