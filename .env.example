# Copy to .env and fill real values. Never commit .env.

POSTGRES_USER=notificationhub
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=notificationhub

RABBITMQ_USER=notificationhub
RABBITMQ_PASSWORD=change-me-strong-password

# Required on first boot when DB has no API keys (maps to Auth__BootstrapApiKey)
# Use a long random string in Production. Forbidden: dev-secret-key-change-me
AUTH_BOOTSTRAP_API_KEY=

# Optional ASP.NET Core overrides (double underscore)
# ConnectionStrings__Default=Host=...;Port=6432;Database=...;Username=...;Password=...
# RabbitMQ__HostName=rabbitmq
# RabbitMQ__UserName=...
# RabbitMQ__Password=...
# Auth__BootstrapApiKey=...
# AllowedHosts=api.example.com
