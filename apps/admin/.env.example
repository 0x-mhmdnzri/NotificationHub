# Public browser config only — never put secrets in NEXT_PUBLIC_*
NEXT_PUBLIC_API_BASE_URL=https://api.example.com
NEXT_PUBLIC_IDENTITY_AUTHORITY=https://id.example.com
NEXT_PUBLIC_OIDC_CLIENT_ID=admin-ui
NEXT_PUBLIC_OIDC_REDIRECT_URI=https://admin.example.com/auth/callback
NEXT_PUBLIC_OIDC_SCOPES=openid profile email notificationhub.admin offline_access

# Security notes:
# - Use HTTPS in production for API, Identity, and admin origins.
# - Access tokens are held in memory; refresh tokens in sessionStorage until a BFF with httpOnly cookies is deployed.
# - Do not log tokens. Rotate OIDC clients if a public client is compromised.
